# Entity: character

main: kit: entity: character: {

  alias: field: {}

  fields: [
    {
      name: "actor"
      req: false
      short: "Name of the actor who portrayed the character"
      type: "`$STRING`"
    }
    {
      name: "alive"
      req: false
      short: "Whether the character is alive"
      type: "`$BOOLEAN`"
    }
    {
      name: "ancestry"
      req: false
      short: "Ancestry of the character (e.g., pure-blood, half-blood, muggle-born)"
      type: "`$STRING`"
    }
    {
      name: "core"
      req: false
      short: "Core material of the wand"
      type: "`$STRING`"
    }
    {
      name: "dateOfBirth"
      req: false
      short: "Date of birth of the character"
      type: "`$STRING`"
    }
    {
      name: "eyeColour"
      req: false
      short: "Eye color of the character"
      type: "`$STRING`"
    }
    {
      name: "hairColour"
      req: false
      short: "Hair color of the character"
      type: "`$STRING`"
    }
    {
      name: "hogwartsStaff"
      req: false
      short: "Whether the character is a Hogwarts staff member"
      type: "`$BOOLEAN`"
    }
    {
      name: "hogwartsStudent"
      req: false
      short: "Whether the character is a Hogwarts student"
      type: "`$BOOLEAN`"
    }
    {
      name: "house"
      req: false
      short: "Hogwarts house the character belongs to"
      type: "`$STRING`"
    }
    {
      format: "uuid"
      name: "id"
      req: false
      short: "Unique identifier for the character"
      type: "`$STRING`"
    }
    {
      format: "uri"
      name: "image"
      req: false
      short: "URL to an image of the character"
      type: "`$STRING`"
    }
    {
      name: "length"
      req: false
      short: "Length of the wand in inches"
      type: "`$NUMBER`"
    }
    {
      name: "name"
      req: false
      short: "Name of the character"
      type: "`$STRING`"
    }
    {
      name: "patronus"
      req: false
      short: "The character's Patronus form"
      type: "`$STRING`"
    }
    {
      name: "wand"
      req: false
      short: "Information about the character's wand"
      type: "`$OBJECT`"
    }
    {
      name: "wizard"
      req: false
      short: "Whether the character is a wizard or witch"
      type: "`$BOOLEAN`"
    }
    {
      name: "wood"
      req: false
      short: "Type of wood the wand is made from"
      type: "`$STRING`"
    }
  ]

  id: {
    field: "id"
    name: "id"
  }

  name: "character"
  op: {
    list: {
      name: "list"
      points: [
        {
          method: "GET"
          orig: "/api/characters"
          segments: [
            {
              lit: "api"
            }
            {
              lit: "characters"
            }
          ]
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
        {
          method: "GET"
          orig: "/api/characters/staff"
          segments: [
            {
              lit: "api"
            }
            {
              lit: "characters"
            }
            {
              lit: "staff"
            }
          ]
          select: {
            "$action": "staff"
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
        {
          method: "GET"
          orig: "/api/characters/students"
          segments: [
            {
              lit: "api"
            }
            {
              lit: "characters"
            }
            {
              lit: "students"
            }
          ]
          select: {
            "$action": "student"
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
    load: {
      name: "load"
      points: [
        {
          args: {
            params: [
              {
                example: "gryffindor"
                kind: "param"
                name: "house"
                orig: "house"
                reqd: true
                type: "`$STRING`"
              }
            ]
          }
          method: "GET"
          orig: "/api/characters/house/{house}"
          segments: [
            {
              lit: "api"
            }
            {
              lit: "characters"
            }
            {
              lit: "house"
            }
            {
              var: "house"
            }
          ]
          select: {
            exist: [
              "house"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
        {
          args: {
            params: [
              {
                example: "9e3f7ce4-b9a7-4244-b709-dae5c1f1d4a8"
                kind: "param"
                name: "id"
                orig: "id"
                reqd: true
                type: "`$STRING`"
              }
            ]
          }
          method: "GET"
          orig: "/api/character/{id}"
          segments: [
            {
              lit: "api"
            }
            {
              lit: "character"
            }
            {
              var: "id"
            }
          ]
          select: {
            exist: [
              "id"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body.wand`"
          }
        }
      ]
    }
  }

  relations: {
    ancestors: [
      [
        "house"
      ]
    ]
  }



}
