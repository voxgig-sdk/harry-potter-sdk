# Generated from the API definition and overwritten on every build: do not
# edit this file. Put customizations in the guide entry file, which includes
# this one and overrides its defaults:
#   guide.aontu

guide: {
  metrics: count: entity: 2
  metrics: count: path: 6
  metrics: count: method: 6

  entity: character: {
    path: "/api/character/{id}": {
      op: load: method: *GET
      op: load: transform: res: *("`body.wand`")|top
    }
    path: "/api/characters": {
      op: list: method: *GET
    }
    path: "/api/characters/house/{house}": {
      op: load: method: *GET
    }
    path: "/api/characters/staff": {
      action: "staff": {}
      op: list: method: *GET
    }
    path: "/api/characters/students": {
      action: "student": {}
      op: list: method: *GET
    }
  }

  entity: spell: {
    path: "/api/spells": {
      op: list: method: *GET
    }
  }

}